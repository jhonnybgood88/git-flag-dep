{
  "name": "@jhonnybgood88/git-flag-dep",
  "version": "1.0.0",
  "description": "Benign external dependency fixture that writes local flag files from npm lifecycle scripts.",
  "license": "UNLICENSED",
  "scripts": {
    "prepare": "node -e \"require('fs').writeFileSync('./git-flag-dep-prepare-feature-1.txt', '@jhonnybgood88/git-flag-dep prepare ran\\n')\"",
    "preinstall": "node -e \"require('fs').writeFileSync('./git-flag-dep-preinstall-feature-1.txt', '@jhonnybgood88/git-flag-dep preinstall ran\\n')\""
  }
}
